      "css": ".ds-label{display:flex;flex-direction:column;gap:7px;font:10px Manrope,sans-serif;color:#c4c7b4}.ds-field{width:105px;padding:9px 10px;border:1px solid #74785d77;background:#202719;color:#eae7d8;font:11px Manrope,sans-serif;border-radius:4px}.ds-field:focus-visible{outline:3px solid #e4bb6b;outline-offset:5px}"
